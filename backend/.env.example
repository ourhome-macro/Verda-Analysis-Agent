# 模型服务：deepseek / zhipu / custom（均使用 OpenAI 兼容接口）
LLM_PROVIDER=deepseek

# DeepSeek：把真实密钥只写入本机 backend/.env，不要提交
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 当前 Provider 的模型档位。留空则用该 Provider 的默认值：
# DeepSeek default/aux/fast=deepseek-flash，core=deepseek-v4-pro
LLM_MODEL=
LLM_MODEL_CORE=
LLM_MODEL_AUX=
LLM_MODEL_FAST=

# 自定义 OpenAI 兼容服务须填写 LLM_API_KEY、LLM_BASE_URL 和 LLM_MODEL
# 这两项也可覆盖内置 Provider 的密钥和地址
LLM_API_KEY=
LLM_BASE_URL=

# 若 LLM_PROVIDER=zhipu，沿用以下旧配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.1
ZHIPU_MODEL_CORE=glm-5.2
ZHIPU_MODEL_AUX=glm-5.1
ZHIPU_MODEL_FAST=glm-z1-air
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 真实联网调研需要博查 Key
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1

DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=

APP_HOST=0.0.0.0
APP_PORT=8010
FRONTEND_ORIGIN=http://localhost:3400
