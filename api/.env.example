# 模型服务：deepseek / zhipu / custom（均使用 OpenAI 兼容接口）
LLM_PROVIDER=deepseek

# DeepSeek：访客自带 Key 模式可留空；本机开发可在此填写
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 当前 Provider 的模型档位。留空则用该 Provider 的默认值：
# DeepSeek default/aux/fast=deepseek-flash，core=deepseek-v4-pro
LLM_MODEL=
LLM_MODEL_CORE=
LLM_MODEL_AUX=
LLM_MODEL_FAST=

# 自定义 OpenAI 兼容服务须填写 LLM_API_KEY、LLM_BASE_URL 和 LLM_MODEL
# 这两项也可覆盖内置 Provider 的密钥和地址
LLM_API_KEY=
LLM_BASE_URL=

# 若 LLM_PROVIDER=zhipu，沿用以下旧配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.1
ZHIPU_MODEL_CORE=glm-5.2
ZHIPU_MODEL_AUX=glm-5.1
ZHIPU_MODEL_FAST=glm-z1-air
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 真实联网调研需要博查 Key；访客自带 Key 模式可留空
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1

# 可选：多源搜索。Grok planner 模式使用兼容聊天接口生成检索词，
# 再由 AnySearch 取回来源；native 模式需要网关真正执行服务端 web_search。
SEARCH_PROVIDERS=bocha
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com/v1
GROK_SEARCH_API_KEY=
GROK_SEARCH_BASE_URL=https://api.x.ai/v1
GROK_SEARCH_MODEL=grok-4.7
GROK_SEARCH_MODE=native
BOCHA_REQUESTS_PER_SECOND=2
ANYSEARCH_REQUESTS_PER_SECOND=2
GROK_REQUESTS_PER_SECOND=1
SEARCH_MAX_IN_FLIGHT=2
SEARCH_MAX_QUEUE_WAIT=60
COLLECT_BRAND_CONCURRENCY=2
LLM_MAX_INPUT_BYTES=180000

DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=

APP_HOST=0.0.0.0
APP_PORT=8010
FRONTEND_ORIGIN=http://localhost:3400
# 仅在绑定本机地址进行开发时启用左下角密钥设置；云端始终禁用
LOCAL_SETTINGS_ENABLED=false
