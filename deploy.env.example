# 默认只监听服务器本机，通过 SSH 隧道访问，不将明文 HTTP 暴露公网。
SITE_ADDRESS=:80
PUBLISH_HOST=127.0.0.1
PUBLISH_HTTP_PORT=80
PUBLISH_HTTPS_PORT=443

# Docker Hub 直拉模式：改为 YOUR_DOCKER_ID/verda-backend:TAG 等完整镜像名。
# 本地源码构建模式可保留以下默认值。
BACKEND_IMAGE=verda-backend:local
WEB_IMAGE=verda-web:local

# 有公网域名时：SITE_ADDRESS=research.example.com 且 PUBLISH_HOST=0.0.0.0。
# 域名需要先解析到服务器，并开放 TCP 80/443（以及可选 UDP 443）。
